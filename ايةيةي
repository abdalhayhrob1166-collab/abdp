<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>لعبة النقر السريع</title>
    <style>
        body { text-align: center; font-family: sans-serif; overflow: hidden; }
        #game-container { width: 100vw; height: 80vh; position: relative; background: #f0f0f0; border: 2px solid #ccc; }
        #target { width: 50px; height: 50px; background: red; border-radius: 50%; position: absolute; cursor: pointer; }
    </style>
</head>
<body>
    <h1>النقاط: <span id="score">0</span></h1>
    <div id="game-container">
        <div id="target"></div>
    </div>

    <script>
        let score = 0;
        const target = document.getElementById('target');
        const scoreDisplay = document.getElementById('score');

        function moveTarget() {
            const x = Math.random() * (window.innerWidth - 50);
            const y = Math.random() * (window.innerHeight * 0.8 - 50);
            target.style.left = x + 'px';
            target.style.top = y + 'px';
        }

        target.addEventListener('click', () => {
            score++;
            scoreDisplay.innerText = score;
            moveTarget();
        });

        // تحريك الدائرة كل ثانية تلقائياً
        setInterval(moveTarget, 1000);
        moveTarget();
    </script>
</body>
</html>
